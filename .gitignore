# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
env/
venv/
.venv/

# Ignore configuration or sensitive files
environment.yml
*.yaml

# Ignore training checkpoints and logs
logs/
*.ckpt

# Ignore dataset or large data files
dataset/
*.h5
*.npy
*.npz
*.json
*.pth

# Ignore wandb logs and cache
wandb/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE and editor-specific files
.vscode/
.idea/
*.swp
